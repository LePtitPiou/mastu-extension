
PORT=3000
NODE_ENV=development

# YouTube Data API v3
YOUTUBE_API_KEY=TA_CLE_YOUTUBE

# Twitch Developer Application
TWITCH_CLIENT_ID=TON_CLIENT_ID_TWITCH
TWITCH_CLIENT_SECRET=TON_CLIENT_SECRET_TWITCH

# Identifiant de l'extension Chrome après publication.
# Plusieurs identifiants peuvent être séparés par des virgules.
CHROME_EXTENSION_IDS=

# Durée du cache en secondes
CACHE_TTL_SECONDS=60
