{
  "manifest_version": 3,
  "name": "Mastu Extension",
  "version": "1.0.0",
  "description": "Retrouve les actualités, vidéos et lives des chaînes Mastu.",
  "permissions": [
    "storage",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://*.onrender.com/*",
    "https://api.twitch.tv/*",
    "https://www.googleapis.com/*",
    "https://www.youtube.com/*",
    "https://twitch.tv/*",
    "https://www.twitch.tv/*"
  ],
  "action": {
    "default_title": "Mastu Extension",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/mastu",
        "https://twitch.tv/mastu"
      ],
      "js": [
        "twitch.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}