{
  "manifest_version": 3,
  "name": "Mastu Extension",
  "version": "1.1.0",
  "description": "L'extension des fans de Mastu : live, vidéos, annonces et options Twitch.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["https://*.onrender.com/*", "https://www.twitch.tv/*"],
  "content_scripts": [
    { "matches": ["https://www.twitch.tv/*"], "js": ["farmer.js"], "run_at": "document_start" }
  ]
}
