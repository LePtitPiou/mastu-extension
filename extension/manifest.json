{
  "manifest_version": 3,
  "name": "Mastu Tracker",
  "version": "1.4.0",
  "description": "Mastu Tracker : live, vidéos, calendrier, annonces et options Twitch.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://*.onrender.com/*",
    "https://www.twitch.tv/*",
    "https://i.ytimg.com/*",
    "https://yt3.ggpht.com/*",
    "https://yt3.googleusercontent.com/*",
    "https://static-cdn.jtvnw.net/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "js": [
        "farmer.js"
      ],
      "run_at": "document_start"
    }
  ]
}
