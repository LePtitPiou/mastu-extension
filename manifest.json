
{
  "manifest_version": 3,
  "name": "Mastu Extension",
  "version": "1.2.0",
  "description": "Retrouve les chaînes de Mastu et consulte leurs statistiques Twitch et YouTube.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mastu Extension"
  },
  "host_permissions": [
    "https://mastu-extension-api.onrender.com/*"
  ]
}
